{
	"name": "omp-antigravity",
	"version": "0.1.0",
	"description": "Oh My Pi provider for Google's official Antigravity CLI (agy) over ACP; Oh My Pi keeps its own tools, approval policy, and transcript",
	"type": "module",
	"license": "MIT",
	"homepage": "https://alphastorm.github.io/omp-antigravity/",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/alphastorm/omp-antigravity.git"
	},
	"bugs": {
		"url": "https://github.com/alphastorm/omp-antigravity/issues"
	},
	"omp": {
		"extensions": ["./src/index.ts"]
	},
	"files": ["src", "docs", "README.md", "CHANGELOG.md", "SECURITY.md", "LICENSE", "NOTICE.md"],
	"scripts": {
		"check": "tsc --noEmit",
		"test": "bun test test/unit",
		"test:docs": "bun test test/docs",
		"test:live": "bun test/live/smoke.ts",
		"doctor": "bun src/doctor.ts",
		"render:assets": "bun scripts/render-assets.ts"
	},
	"dependencies": {
		"@agentclientprotocol/sdk": "2.5.0",
		"@modelcontextprotocol/server": "2.4.0",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@modelcontextprotocol/client": "2.4.0",
		"@oh-my-pi/pi-ai": "18.18.7",
		"@oh-my-pi/pi-coding-agent": "18.18.7",
		"@types/bun": "1.4.4",
		"typescript": "7.0.2"
	}
}
