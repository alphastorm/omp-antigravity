{
	"name": "omp-antigravity",
	"version": "0.1.0",
	"description": "OMP provider for Google's official Antigravity CLI over ACP; OMP keeps its own tools, policy, and transcript",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/alphastorm/omp-antigravity.git"
	},
	"omp": {
		"extensions": ["./src/index.ts"]
	},
	"files": ["src", "README.md", "LICENSE", "NOTICE.md"],
	"scripts": {
		"check": "tsc --noEmit",
		"test": "bun test test/unit",
		"test:live": "bun test/live/smoke.ts",
		"doctor": "bun src/doctor.ts"
	},
	"dependencies": {
		"@agentclientprotocol/sdk": "2.5.0",
		"@modelcontextprotocol/server": "2.4.0",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@modelcontextprotocol/client": "2.4.0",
		"@oh-my-pi/pi-ai": "18.18.7",
		"@oh-my-pi/pi-coding-agent": "18.18.7",
		"@types/bun": "1.4.4",
		"typescript": "7.0.2"
	}
}
